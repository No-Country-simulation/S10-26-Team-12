# Base de datos y Docker Compose
# Copiar a .env para personalizar. Los valores por defecto permiten correr sin .env.
# Todos los servicios usan estas variables; no hay configuración para ejecutar en el host.
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=repusense_db

# Migraciones
# true muestra el detalle de node-pg-migrate en cada ejecución.
MIGRATION_VERBOSE=false

# Backend
PORT=5000
NODE_ENV=development
JWT_SECRET=cambiar_esto

# Frontend (lo usa el navegador, no el contenedor)
VITE_API_URL=http://localhost:5000

# IA (proveedor todavía sin definir)
AI_API_KEY=
